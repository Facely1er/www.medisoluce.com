# Enforce the Node range in package.json "engines".
# `vite build` fails on Node 22+/24 (vite-plugin-pwa -> workbox-build -> @rollup/plugin-terser
# never resolves its renderChunk hook and no service worker is emitted). CI, Netlify and the
# Dockerfile all pin Node 20; this makes local installs fail fast instead of producing a broken PWA.
engine-strict=true
