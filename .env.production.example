# MediSoluce production environment
# Set these in Netlify / Vercel / GitHub Actions. Do not commit real values.

# Auth / billing. Leave local + billing false for the public demo.
VITE_AUTH_PROVIDER=local
VITE_ENABLE_BILLING=false
VITE_APP_BASE_URL=https://www.medisoluce.com

# Client deployment with real accounts (set both):
# VITE_AUTH_PROVIDER=supabase
# VITE_ENABLE_BILLING=true
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — preferred: Payment Links from the Dashboard (buy.stripe.com/...).
# No serverless checkout call; upgrade buttons redirect straight to the link.
# After payment, set the Payment Link success URL to https://www.medisoluce.com/checkout/success
# VITE_ENABLE_BILLING=true
# VITE_STRIPE_PAYMENT_LINK_HIPAA_PROFESSIONAL=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_RANSOMWARE_PROFESSIONAL=https://buy.stripe.com/...
# VITE_STRIPE_PAYMENT_LINK_CONTINUITY_PROFESSIONAL=https://buy.stripe.com/...
#
# Optional webhook (same endpoint) if you want subscription records in Supabase:
# STRIPE_SECRET_KEY=sk_live_or_test
# STRIPE_WEBHOOK_SECRET=whsec_...
# Point Stripe webhook to https://www.medisoluce.com/api/webhook
#
# Fallback: Checkout Session API via Price IDs (needs STRIPE_SECRET_KEY on the server).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
# STRIPE_ALLOWED_PRICE_IDS=price_aaa,price_bbb
# VITE_STRIPE_PRICE_HIPAA_PROFESSIONAL=price_...
# VITE_STRIPE_PRICE_RANSOMWARE_PROFESSIONAL=price_...
# VITE_STRIPE_PRICE_CONTINUITY_PROFESSIONAL=price_...

# Optional
# VITE_GA_TRACKING_ID=G-VEQXJHYNHG
# VITE_SENTRY_DSN=your-sentry-dsn
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

NODE_ENV=production
VITE_APP_VERSION=1.0.0
