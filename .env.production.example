# MediSoluce Healthcare Compliance Platform - Production Environment Variables
# Copy this file to .env.production.local and fill in your actual values

# Auth/Billing Mode
VITE_AUTH_PROVIDER=supabase
VITE_ENABLE_BILLING=true

# Supabase Configuration (required when VITE_AUTH_PROVIDER=supabase)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Analytics and Monitoring (same tag as technoSoluce/ERMITS)
VITE_GA_TRACKING_ID=G-VEQXJHYNHG
VITE_SENTRY_DSN=your-sentry-dsn

# Optional: Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Optional: API Endpoints
VITE_API_BASE_URL=https://api.medisoluce.com
VITE_CDN_URL=https://cdn.medisoluce.com

# Stripe (checkout + webhooks). Use real Stripe Price IDs (price_...) in the app config.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_APP_BASE_URL=https://www.medisoluce.com

# Server-only: Stripe webhook writes to the medisoluce schema
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
VITE_SENDGRID_API_KEY=your-sendgrid-key

# Development/Testing
NODE_ENV=production
VITE_APP_VERSION=1.0.0
VITE_BUILD_DATE=2024-01-01T00:00:00Z
