# MediSoluce environment variables
# Copy to .env.local for local development.

# Auth / billing
# Demo (default): local browser storage, checkout off.
# Paid client: VITE_AUTH_PROVIDER=supabase, VITE_ENABLE_BILLING=true, plus the keys below.
VITE_AUTH_PROVIDER=local
VITE_ENABLE_BILLING=false
VITE_APP_BASE_URL=http://localhost:5173

# Supabase (required only when VITE_AUTH_PROVIDER=supabase)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Stripe (client). Server keys belong in Netlify/Vercel, never in the frontend bundle.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PRICE_HIPAA_ESSENTIAL=price_...
# VITE_STRIPE_PRICE_HIPAA_PROFESSIONAL=price_...
# VITE_STRIPE_PRICE_RANSOMWARE_ESSENTIAL=price_...
# VITE_STRIPE_PRICE_RANSOMWARE_PROFESSIONAL=price_...
# VITE_STRIPE_PRICE_CONTINUITY_ESSENTIAL=price_...
# VITE_STRIPE_PRICE_CONTINUITY_PROFESSIONAL=price_...

# Optional analytics / error tracking
# VITE_GA_TRACKING_ID=G-VEQXJHYNHG
# VITE_SENTRY_DSN=https://...

VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_PWA=true
